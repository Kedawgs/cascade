{
  "name": "cascade-indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --project worker --project node",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "types": "wrangler types --env test --strict-vars=false",
    "bundle": "wrangler deploy --dry-run --outdir .wrangler/dry-run --env test",
    "dev": "wrangler dev --env test --test-scheduled",
    "wrangler": "wrangler",
    "smoke": "node -e \"console.error('smoke: not built yet (plan Task 30)'); process.exit(1)\"",
    "fixtures": "node scripts/write-seed-fixtures.ts",
    "config:from-record": "node scripts/config-from-record.ts",
    "site:approved": "node scripts/site-approved.ts",
    "hold:clear": "node scripts/hold-clear.ts",
    "alerts:ack": "node scripts/alerts-ack.ts",
    "checks:approve": "node scripts/checks-approve.ts"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.2",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.151.0"
  },
  "packageManager": "pnpm@11.23.0"
}
