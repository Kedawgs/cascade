// Cascade's history indexer and monitor: one Worker, one D1 database per environment.
// Nothing here is a secret. Secrets (ALERT_TO, keyed RPC URLs, private THRESHOLDS) are set with
// `wrangler secret put` at deploy time, or in a git-ignored .dev.vars for local runs.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cascade-indexer",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-14",
  // Wrangler sends no usage telemetry for this project: building and testing stay local.
  "send_metrics": false,
  "observability": { "enabled": true },
  // Workers Cache serves the seed routes (30 s), the status and the health (15 s) by their Cache-Control without
  // running the Worker.
  "cache": { "enabled": true },
  // Four crons, the same in every environment (a test checks them against src/crons.ts):
  // the tick every minute, the site check every two minutes (a run of the pass under way: a pass of every page
  // in SITE_PAGES starts an hour after the last finished, see src/site-job.ts), the hourly job and the daily digest.
  // The account is on Workers Paid (open question 1), which allows 250 crons, so test and production
  // run side by side in it. Workers Free allows five per account: there only one environment fits.
  "triggers": { "crons": ["* * * * *", "*/2 * * * *", "17 * * * *", "0 13 * * *"] },
  // Budgets, two profiles (spec section 12). Both environments use the Workers Paid profile: about 30 s
  // of CPU per cron invocation, 1,000+ subrequests, 1,000 D1 queries per invocation and a monthly D1
  // allowance. The values stay well inside those. Every budget is a var.
  //   var                 Paid (set)   Free (fallback: not viable for a full batch, see below)
  //   SUBREQUEST_BUDGET   200          45     (Free: 50 external subrequests per invocation)
  //   DECODE_BUDGET       5000         100    (about 110-125 µs a log, measured in local workerd: ~0.6 s on Paid)
  //   SITE_FILES_PER_RUN  20           2      (Free: a big chunk can use up 10 ms of CPU)
  //   SCAN_WALL_S         40           40     (a tick a minute either way)
  //   LEASE_S             180          180    (at least 3 × SCAN_WALL_S)
  //   SITE_MAX_BYTES      2000000      2000000
  // Free's 10 ms of CPU doesn't fit a full batch delivery: one block of about 205 logs, which the scan never
  // splits, takes about 23-26 ms to hash and decode, so the tick that meets it would be killed every minute.
  "env": {
    // The v3 test deployment.
    "test": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cascade-indexer-test",
          // The owner replaces this with the id `wrangler d1 create` prints, at deploy (an id, not a secret).
          "database_id": "local-only-test",
          "migrations_dir": "migrations"
        }
      ],
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["monitor@cascadefi.xyz"] }],
      // Workers Rate Limiting on every route (/v1/scan/*, /v1/status and /v1/health, each under its own key): 60
      // requests a minute per client IP, counted per Cloudflare location (approximate). Cached answers never reach
      // the Worker, so never count. The namespace id is any integer unique in the account (nothing to create);
      // each environment has its own.
      "ratelimits": [{ "name": "SCAN_LIMITER", "namespace_id": "8453001", "simple": { "limit": 60, "period": 60 } }],
      // Public settings (spec section 9). A secret named <VAR>_SECRET overrides BASE_RPC_URL,
      // BASE_LOGS_RPC_URL, BITTENSOR_RPC_URL and THRESHOLDS (a keyed URL, private thresholds); ALERT_TO
      // is a secret only. src/config.ts checks all of it at the start of every invocation.
      "vars": {
        // The v3 test deployment's addresses and blocks, as `pnpm config:from-record
        // ../ops/deployments/v3-test.json` prints them (spec section 11, step 6): Bittensor starts at the
        // Bittensor adapter's creation block, the site's NEXT_PUBLIC_CASCADE_BIT_BLOCK, so the seed's `from`
        // matches the site's scans. BRIDGES isn't set: it defaults to these two adapters.
        "DEPLOYMENT": {
          "base": { "chainId": 8453, "startBlock": "53119544", "baselineBlock": "53119575" },
          "bittensor": { "chainId": 964, "startBlock": "9368744", "baselineBlock": "9368753" },
          "frontDoor": "0xDBe6aDCac889adcbE4D4230a82C8d719FB3C1f8B",
          "baseAdapter": "0x7c9Ceb476C50B4E4eCc1610d3cEe5d146c2bB9a0",
          "staker": "0x5659c5929Dfe7993f3db521582B0201d6bf246B7",
          "oracle": "0x45614AE84875EFA577F21F85cf8a6abAA6B2f217",
          "vault": "0x32f4c98ACb181a80343CC0925b4202C35e0EB6e3",
          "bitAdapter": "0x5659c5929Dfe7993f3db521582B0201d6bf246B7",
          "vaultColdkey": "0x34680a431a7295c7df20c0482c37e06788390d7c8ad1f6abb7693394a269a0fa",
          "stakeHotkey": "0x56a9aee6291bd03ab6d36d4d13e2bebae7cd403518066c72fba1b417d6ddd748",
          "batchMaxWaitS": 0
        },
        "BASE_RPC_URL": "https://mainnet.base.org",
        // mainnet.base.org refuses eth_getLogs; publicnode answers 100-block windows with the head
        "BASE_LOGS_RPC_URL": "https://base-rpc.publicnode.com",
        // the archive node: the lite node keeps only minutes of logs
        "BITTENSOR_RPC_URL": "https://archive.chain.opentensor.ai",
        // the hourly cross-check's second logs endpoint per chain, from another provider than the primary (the
        // config refuses the same registrable domain): a lying or pruning primary is noticed. Overridden by
        // BASE_LOGS_RPC_URL_2_SECRET and BITTENSOR_RPC_URL_2_SECRET (keyed URLs). OnFinality's public Bittensor
        // node serves batched eth_getLogs and eth_blockNumber (1.3-5 s a call; dRPC's Bittensor needs a paid plan).
        "BASE_LOGS_RPC_URL_2": "https://base.drpc.org",
        "BITTENSOR_RPC_URL_2": "https://bittensor-finney.api.onfinality.io/public",
        "BASE_LOG_WINDOW": "100",
        // the Workers Paid profile (see the table above; Free: 45, 100, 2)
        "SUBREQUEST_BUDGET": "200",
        // logs a tick may hash and decode, both chains together: about 110-125 µs each (measured in local
        // workerd). A log already stored at the same place costs nothing.
        "DECODE_BUDGET": "5000",
        "SCAN_WALL_S": "40",
        "LEASE_S": "180",
        "SITE_FILES_PER_RUN": "20",
        "SITE_MAX_BYTES": "2000000",
        "SITE_ORIGIN": "https://cascadefi.xyz",
        "SITE_URL": "https://cascadefi.xyz",
        // every page of the site (test/node/site-pages.test.ts checks them against web/src/app)
        "SITE_PAGES": ["/", "/activity/", "/deposit/", "/faq/", "/rewards/", "/stake/", "/unstake/", "/withdraw/"],
        "ALERT_FROM": "monitor@cascadefi.xyz",
        // log: emails are written to the log, never sent (until the owner deploys and verifies a recipient)
        "ALERT_MODE": "log",
        "THRESHOLDS": "{}",
        "PRICE_SOURCES": ["coingecko", "coinbase"],
        // Public contracts the monitor reads (ops/src/config.ts LIVE and BASE_V3, and Multicall3)
        "TOKENS": {
          "multicall3": "0xcA11bde05977b3631167028862bE2a173976CA11",
          "base": {
            "fmTao": "0xf3081494B87e8D5fb7960f066E931D1D0e6E3d67",
            "usdc": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
            "weth": "0x4200000000000000000000000000000000000006",
            "taoWethPool": "0x82dD34C6631C286cDD1dB16f2c232f60E402Dd5A",
            "wethUsdcPool": "0xd0b53D9277642d899DF5C87A3966A349A798F224",
            "offRamp": "0x16E577f1724AE2598F9b43a52C19E6f67eE13808"
          },
          "bittensor": {
            "fmTao": "0xC5b6C1632d34901239396F5E1BDe54B342900256",
            "lockPool": "0xB66b9c085ab711ECC373aaF6dc959a4A6B42BE2e",
            "offRamp": "0xF9410A08FD57e629c66E1f37a5Ae8f0a757d9AD9",
            "alphaVault": "0x11837459896D96F821a8D88eC93a3C8D152033D4"
          }
        }
      }
    },
    // The launch deployment (v3-launch), in the same account as test.
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cascade-indexer-production",
          "database_id": "1bfa3258-3d46-4beb-b0c4-6a9e26fa9fc7",
          "migrations_dir": "migrations"
        }
      ],
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["monitor@cascadefi.xyz"] }],
      // As test's (its own namespace, so the two never share counters)
      "ratelimits": [{ "name": "SCAN_LIMITER", "namespace_id": "8453002", "simple": { "limit": 60, "period": 60 } }],
      // As test's, with the launch deployment's own DEPLOYMENT (and, once the owner has chosen and verified
      // a recipient after the first deploy, ALERT_MODE "send").
      "vars": {
        // The v3-launch deployment's addresses and blocks, as `pnpm config:from-record
        // ../ops/deployments/v3-launch.json --setup-ends-base 53297722 --setup-ends-bittensor 9398435`
        // prints them (verified 2026-10-30): Bittensor starts at the Bittensor adapter's creation block, the
        // site's NEXT_PUBLIC_CASCADE_BIT_BLOCK; the launch cadence's 24-hour close wait. The baselines are
        // later than the record's last steps (53295834, 9398130): the owner's Ledger accepted ownership after
        // the deploy (front door 53297713, staker 53297722, vault 9398435), and that is setup, not an alert.
        // BRIDGES isn't set: it defaults to these two adapters.
        "DEPLOYMENT": {
          "base": { "chainId": 8453, "startBlock": "53295800", "baselineBlock": "53297722" },
          "bittensor": { "chainId": 964, "startBlock": "9398120", "baselineBlock": "9398435" },
          "frontDoor": "0xbAe5417A40613141790624bCeF6BaFc3b24ff9AA",
          "baseAdapter": "0xF2B3A36185e74ddCf8Ea9A174c06b75520F47F92",
          "staker": "0xe33012f8ae80E17a7D7B8d9249043dB01D27e59E",
          "oracle": "0xcAa85F00b6e470Dd28a31FBa982267B820736eBc",
          "vault": "0x450cD94401B45c72C09734071fe683F6b74Aea72",
          "bitAdapter": "0x002d7C6b2A6062d4E066FB41671DbB3Fd4f388E1",
          "vaultColdkey": "0x64697e140ee4cf255f1dd88ee3afaef243310ee8e87ce9334137947fa575040a",
          "stakeHotkey": "0x56a9aee6291bd03ab6d36d4d13e2bebae7cd403518066c72fba1b417d6ddd748",
          "batchMaxWaitS": 86400
        },
        // mainnet.base.org answers HTTP 429 to Cloudflare's shared egress (seen on the first production
        // ticks), so production reads Base through publicnode too; BASE_RPC_URL_SECRET (a keyed URL) overrides
        "BASE_RPC_URL": "https://base-rpc.publicnode.com",
        "BASE_LOGS_RPC_URL": "https://base-rpc.publicnode.com",
        "BITTENSOR_RPC_URL": "https://archive.chain.opentensor.ai",
        // the second logs endpoints (as test's): another provider than the primary, for the hourly cross-check
        "BASE_LOGS_RPC_URL_2": "https://base.drpc.org",
        "BITTENSOR_RPC_URL_2": "https://bittensor-finney.api.onfinality.io/public",
        "BASE_LOG_WINDOW": "100",
        // the Workers Paid profile (see the table above; Free: 45, 100, 2)
        "SUBREQUEST_BUDGET": "200",
        "DECODE_BUDGET": "5000",
        "SCAN_WALL_S": "40",
        "LEASE_S": "180",
        "SITE_FILES_PER_RUN": "20",
        "SITE_MAX_BYTES": "2000000",
        "SITE_ORIGIN": "https://cascadefi.xyz",
        "SITE_URL": "https://cascadefi.xyz",
        // every page of the site (test/node/site-pages.test.ts checks them against web/src/app)
        "SITE_PAGES": ["/", "/activity/", "/deposit/", "/faq/", "/rewards/", "/stake/", "/unstake/", "/withdraw/"],
        "ALERT_FROM": "monitor@cascadefi.xyz",
        "ALERT_MODE": "send",
        "THRESHOLDS": "{}",
        "PRICE_SOURCES": ["coingecko", "coinbase"],
        "TOKENS": {
          "multicall3": "0xcA11bde05977b3631167028862bE2a173976CA11",
          "base": {
            "fmTao": "0xf3081494B87e8D5fb7960f066E931D1D0e6E3d67",
            "usdc": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
            "weth": "0x4200000000000000000000000000000000000006",
            "taoWethPool": "0x82dD34C6631C286cDD1dB16f2c232f60E402Dd5A",
            "wethUsdcPool": "0xd0b53D9277642d899DF5C87A3966A349A798F224",
            "offRamp": "0x16E577f1724AE2598F9b43a52C19E6f67eE13808"
          },
          "bittensor": {
            "fmTao": "0xC5b6C1632d34901239396F5E1BDe54B342900256",
            "lockPool": "0xB66b9c085ab711ECC373aaF6dc959a4A6B42BE2e",
            "offRamp": "0xF9410A08FD57e629c66E1f37a5Ae8f0a757d9AD9",
            "alphaVault": "0x11837459896D96F821a8D88eC93a3C8D152033D4"
          }
        }
      }
    }
  }
}
