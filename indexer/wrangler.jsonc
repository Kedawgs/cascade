// Cascade's history indexer and monitor: one Worker, one D1 database per environment.
// Nothing here is a secret. Secrets (ALERT_TO, keyed RPC URLs, private THRESHOLDS) are set with
// `wrangler secret put` at deploy time, or in a git-ignored .dev.vars for local runs.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cascade-indexer",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-14",
  // Wrangler sends no usage telemetry for this project: building and testing stay local.
  "send_metrics": false,
  "observability": { "enabled": true },
  // Workers Cache serves the seed routes by their Cache-Control without running the Worker.
  "cache": { "enabled": true },
  // Four crons, the same in every environment (a test checks them against src/crons.ts):
  // the tick every minute, the site check every two minutes, the hourly job and the daily digest.
  // The account is on Workers Paid (open question 1), which allows 250 crons, so test and production
  // run side by side in it. Workers Free allows five per account: there only one environment fits.
  "triggers": { "crons": ["* * * * *", "*/2 * * * *", "17 * * * *", "0 13 * * *"] },
  // Budgets, two profiles (spec section 12). Both environments use the Workers Paid profile: about 30 s
  // of CPU per cron invocation, 1,000+ subrequests, 1,000 D1 queries per invocation and a monthly D1
  // allowance. The values stay well inside those, and the code stays safe on Free: every budget is a var.
  //   var                 Paid (set)   Free (fallback)
  //   SUBREQUEST_BUDGET   200          45     (Free: 50 external subrequests per invocation)
  //   DECODE_BUDGET       5000         100    (about 42 µs a log: ~210 ms on Paid, ~4 ms of Free's 10 ms)
  //   SITE_FILES_PER_RUN  20           2      (Free: a big chunk can use up 10 ms of CPU)
  //   SCAN_WALL_S         40           40     (a tick a minute either way)
  //   LEASE_S             180          180    (at least 3 × SCAN_WALL_S)
  //   SITE_MAX_BYTES      2000000      2000000
  // To run on Free, set the Free column in the environment's vars.
  "env": {
    // The v3 test deployment.
    "test": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cascade-indexer-test",
          // The owner replaces this with the id `wrangler d1 create` prints, at deploy (an id, not a secret).
          "database_id": "local-only-test",
          "migrations_dir": "migrations"
        }
      ],
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["monitor@cascade.fi"] }],
      // Public settings (spec section 9). A secret named <VAR>_SECRET overrides BASE_RPC_URL,
      // BASE_LOGS_RPC_URL, BITTENSOR_RPC_URL and THRESHOLDS (a keyed URL, private thresholds); ALERT_TO
      // is a secret only. src/config.ts checks all of it at the start of every invocation.
      "vars": {
        // The deployment's addresses and blocks: `pnpm config:from-record ../ops/deployments/v3-test.json`
        // prints the JSON to paste here (spec section 11, step 6). Until then the Worker refuses to run.
        "DEPLOYMENT": "not configured: paste the JSON printed by pnpm config:from-record",
        "BASE_RPC_URL": "https://mainnet.base.org",
        // mainnet.base.org refuses eth_getLogs; publicnode answers 100-block windows with the head
        "BASE_LOGS_RPC_URL": "https://base-rpc.publicnode.com",
        // the archive node: the lite node keeps only minutes of logs
        "BITTENSOR_RPC_URL": "https://archive.chain.opentensor.ai",
        "BASE_LOG_WINDOW": "100",
        // the Workers Paid profile (see the table above; Free: 45, 100, 2)
        "SUBREQUEST_BUDGET": "200",
        // logs a tick may hash and decode, both chains together: about 42 µs each (23 to hash, 19 to
        // decode). A log already stored at the same place costs nothing.
        "DECODE_BUDGET": "5000",
        "SCAN_WALL_S": "40",
        "LEASE_S": "180",
        "SITE_FILES_PER_RUN": "20",
        "SITE_MAX_BYTES": "2000000",
        "SITE_ORIGIN": "https://cascade.fi",
        "SITE_URL": "https://cascade.fi",
        "SITE_PAGES": ["/", "/stake/"],
        "ALERT_FROM": "monitor@cascade.fi",
        // log: emails are written to the log, never sent (until the owner deploys and verifies a recipient)
        "ALERT_MODE": "log",
        "THRESHOLDS": "{}",
        "PRICE_SOURCES": ["coingecko", "coinbase"],
        // Public contracts the monitor reads (ops/src/config.ts LIVE and BASE_V3, and Multicall3)
        "TOKENS": {
          "multicall3": "0xcA11bde05977b3631167028862bE2a173976CA11",
          "base": {
            "fmTao": "0xf3081494B87e8D5fb7960f066E931D1D0e6E3d67",
            "usdc": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
            "weth": "0x4200000000000000000000000000000000000006",
            "taoWethPool": "0x82dD34C6631C286cDD1dB16f2c232f60E402Dd5A",
            "wethUsdcPool": "0xd0b53D9277642d899DF5C87A3966A349A798F224",
            "offRamp": "0x16E577f1724AE2598F9b43a52C19E6f67eE13808"
          },
          "bittensor": {
            "fmTao": "0xC5b6C1632d34901239396F5E1BDe54B342900256",
            "lockPool": "0xB66b9c085ab711ECC373aaF6dc959a4A6B42BE2e",
            "offRamp": "0xF9410A08FD57e629c66E1f37a5Ae8f0a757d9AD9",
            "alphaVault": "0x11837459896D96F821a8D88eC93a3C8D152033D4"
          }
        }
      }
    },
    // The launch deployment, once it exists, in the same account as test. Until its DEPLOYMENT is
    // pasted the Worker refuses to run in it.
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cascade-indexer-production",
          "database_id": "local-only-production",
          "migrations_dir": "migrations"
        }
      ],
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["monitor@cascade.fi"] }],
      // As test's, with the launch deployment's own DEPLOYMENT (and, at launch, ALERT_MODE "send").
      "vars": {
        "DEPLOYMENT": "not configured: paste the JSON printed by pnpm config:from-record",
        "BASE_RPC_URL": "https://mainnet.base.org",
        "BASE_LOGS_RPC_URL": "https://base-rpc.publicnode.com",
        "BITTENSOR_RPC_URL": "https://archive.chain.opentensor.ai",
        "BASE_LOG_WINDOW": "100",
        // the Workers Paid profile (see the table above; Free: 45, 100, 2)
        "SUBREQUEST_BUDGET": "200",
        "DECODE_BUDGET": "5000",
        "SCAN_WALL_S": "40",
        "LEASE_S": "180",
        "SITE_FILES_PER_RUN": "20",
        "SITE_MAX_BYTES": "2000000",
        "SITE_ORIGIN": "https://cascade.fi",
        "SITE_URL": "https://cascade.fi",
        "SITE_PAGES": ["/", "/stake/"],
        "ALERT_FROM": "monitor@cascade.fi",
        "ALERT_MODE": "log",
        "THRESHOLDS": "{}",
        "PRICE_SOURCES": ["coingecko", "coinbase"],
        "TOKENS": {
          "multicall3": "0xcA11bde05977b3631167028862bE2a173976CA11",
          "base": {
            "fmTao": "0xf3081494B87e8D5fb7960f066E931D1D0e6E3d67",
            "usdc": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
            "weth": "0x4200000000000000000000000000000000000006",
            "taoWethPool": "0x82dD34C6631C286cDD1dB16f2c232f60E402Dd5A",
            "wethUsdcPool": "0xd0b53D9277642d899DF5C87A3966A349A798F224",
            "offRamp": "0x16E577f1724AE2598F9b43a52C19E6f67eE13808"
          },
          "bittensor": {
            "fmTao": "0xC5b6C1632d34901239396F5E1BDe54B342900256",
            "lockPool": "0xB66b9c085ab711ECC373aaF6dc959a4A6B42BE2e",
            "offRamp": "0xF9410A08FD57e629c66E1f37a5Ae8f0a757d9AD9",
            "alphaVault": "0x11837459896D96F821a8D88eC93a3C8D152033D4"
          }
        }
      }
    }
  }
}
