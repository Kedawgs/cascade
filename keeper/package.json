{
  "name": "cascade-keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --project worker --project node",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "types": "wrangler types --env test --strict-vars=false",
    "bundle": "wrangler deploy --dry-run --outdir .wrangler/dry-run --env test",
    "keeper:new-key": "node scripts/new-key.ts",
    "keeper:put-key": "node scripts/new-key.ts put",
    "keeper:new-token": "node scripts/new-token.ts",
    "config:from-record": "node --env-file-if-exists=../ops/.env scripts/config-from-record.ts",
    "wrangler": "wrangler"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.2",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.151.0"
  },
  "packageManager": "pnpm@11.23.0"
}
