// cascade-keeper: the v3.2 keeper as its own Worker (design-keeper-worker.md). Run wrangler only from this folder.
// Nothing here is a secret. The secrets are set at deploy (Task 67), never here:
//   KEEPER_PRIVATE_KEY      pnpm keeper:new-key -- --env <test|production> --put-secret
//   CONTROL_TOKEN_SHA256    pnpm keeper:new-token -- --env <test|production> --put-secret
//   BASE_RPC_URL_SECRET, BASE_LOGS_RPC_URL_SECRET, BITTENSOR_RPC_URL_SECRET   keyed RPC URLs (they override the vars below)
// Deploy at 100%, never as a gradual deployment, so two versions never run side by side (design §4).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cascade-keeper",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-14",
  // Wrangler sends no usage telemetry for this project: building and testing stay local.
  "send_metrics": false,
  // Workers Logs: every line the keeper logs (scrubbed of URL secrets and of the key), kept 7 days.
  "observability": { "enabled": true },
  // The control routes answer on the keeper's own hostname only (a custom domain chosen at Task 67), never on workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  // One copy of viem and of noble's hashes in the bundle: the core's imports (../ops/src/keeper/core, which would find
  // ops' own copies) and the Worker's resolve to this package's, at the ES module entry each package's exports map names
  // (test/node/bundle.test.ts holds them to the maps, bundles, and counts the copies).
  "alias": {
    "viem": "./node_modules/viem/_esm/index.js",
    "viem/accounts": "./node_modules/viem/_esm/accounts/index.js",
    "@noble/hashes/blake2": "./node_modules/@noble/hashes/esm/blake2.js"
  },
  // The lease, the kill switch, the memory and the journal (src/coordinator.ts). Never rename or delete this class: a
  // delete migration erases its data.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["KeeperCoordinator"] }],
  // Budgets (Workers Paid; design §5): 30 s of CPU an invocation by default (a full round took 55 to 179 ms in local
  // workerd over a fake RPC, Task 50b), 15 min of wall time for a cron, 1,000+ subrequests (a round made 17 to 157). A run makes at most
  // KEEPER_SUBREQUEST_BUDGET RPC requests (a send's own get 100 more), starts no send after 45 s and waits at most 40 s
  // for a receipt; the lease lasts 120 s.
  "env": {
    // The testnet deployment (Tasks 62 to 64).
    "test": {
      // One round a minute (in each environment only, so a deploy without --env makes no cron). From a phone:
      // Cloudflare dashboard, cascade-keeper-<env>, Triggers, delete the cron to stop it.
      "triggers": { "crons": ["* * * * *"] },
      "durable_objects": { "bindings": [{ "name": "COORDINATOR", "class_name": "KeeperCoordinator" }] },
      // 30 control requests a minute per client and route; the namespace id is any integer unique in the account
      "ratelimits": [{ "name": "KEEPER_LIMITER", "namespace_id": "8453101", "simple": { "limit": 30, "period": 60 } }],
      // the monitor's /v1/status for the hold (Task 50a), one way: the monitor gets nothing from the keeper
      "services": [{ "binding": "MONITOR", "service": "cascade-indexer-test" }],
      "vars": {
        // the v3.2 deployment, as `pnpm config:from-record -- <record>` prints it (Task 62 for test, Task 67 for production);
        // empty: the keeper runs nothing
        "DEPLOYMENT": "",
        "BASE_RPC_URL": "https://base-rpc.publicnode.com",
        "BASE_LOGS_RPC_URL": "https://base-rpc.publicnode.com",
        // the archive node: the lite node keeps only minutes of logs
        "BITTENSOR_RPC_URL": "https://archive.chain.opentensor.ai",
        "BASE_LOG_WINDOW": "10000",
        "RPC_SPACING_MS": { "base": 100, "bittensor": 600 },
        "KEEPER_SUBREQUEST_BUDGET": "300",
        // ops' OPS_MAX_GAS_PRICE_BASE and OPS_MAX_GAS_PRICE_BITTENSOR defaults
        "MAX_GAS_PRICE_BASE_GWEI": "5",
        "MAX_GAS_PRICE_BITTENSOR_GWEI": "100",
        // Task 52: the keeper re-executes no CCIP FAILURE by itself (the founder's ruling: by hand, pnpm ops reexec); it
        // reports each one with the hand command. "on" only after Task 61's rehearsals
        "OPS_REEXEC_AUTO": "off"
      }
    },
    // The v3.2 launch deployment (Task 67).
    "production": {
      "triggers": { "crons": ["* * * * *"] },
      "durable_objects": { "bindings": [{ "name": "COORDINATOR", "class_name": "KeeperCoordinator" }] },
      "ratelimits": [{ "name": "KEEPER_LIMITER", "namespace_id": "8453102", "simple": { "limit": 30, "period": 60 } }],
      "services": [{ "binding": "MONITOR", "service": "cascade-indexer-production" }],
      // the keeper's own hostname (Task 67, runbook 2.3 step 4): the only one its control routes answer on; ops/.env's OPS_KEEPER_URL
      "routes": [{ "pattern": "keeper.cascadefi.xyz", "custom_domain": true }],
      "vars": {
        // the v3.2-launch deployment, as `pnpm config:from-record -- ../ops/deployments/v3.2-launch.json` printed it on deploy day
        // (2026-11-16, Task 67). A var holds 5 kB and the record is 10, so its for-life list is in the numbered parts below,
        // which the Worker joins and holds to the digest forLifeParts names (src/deployment-vars.ts): a part missing, out
        // of place, edited or of another printout, and the keeper is not ready
        "DEPLOYMENT": {
          "version": "v3.2",
          "name": "v3.2-launch",
